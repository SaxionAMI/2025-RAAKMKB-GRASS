# Use NVIDIA CUDA base with Python 3.10 and Ubuntu 22.04
FROM nvidia/cuda:11.8.0-base-ubuntu22.04
ARG DEBIAN_FRONTEND=noninteractive

# 1) System deps (build + runtime)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake pybind11-dev \
    libfftw3-dev libfftw3-3 libfftw3-single3 libsndfile1 ffmpeg \
    libgl1-mesa-glx libglib2.0-0 \
    python3 python3-dev python3-pip \
 && rm -rf /var/lib/apt/lists/*

# 2) App workspace
WORKDIR /app
COPY . .

# 3) Env
ENV DAGSTER_HOME=/app/dagster_home
ENV MPLBACKEND=Agg
ENV PYTHONPATH=/app:/app/grass_pipeline_dagster
RUN mkdir -p "$DAGSTER_HOME"

# 4) Build C++ pybind11 module (Release) and place .so in /app/cpp_processing
WORKDIR /app/cpp_processing
RUN rm -rf build CMakeCache.txt \
 && cmake -S . -B build -DCMAKE_BUILD_TYPE=Release \
 && cmake --build build -j \
 && cp build/*.so /app/cpp_processing/

# 5) Python deps (CUDA 11.8 wheels)
WORKDIR /app
RUN python3 -m pip install --upgrade pip \
 && python3 -m pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118 \
 && python3 -m pip install -r grass_pipeline_dagster/requirements.dagster.txt

# 6) Start Dagster
CMD ["dagster", "dev", "-h", "0.0.0.0", "-p", "3000", "-f", "grass_pipeline_dagster/grass_pipeline_dagster/definitions.py"]
