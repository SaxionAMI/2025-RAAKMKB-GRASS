# ✅ Use NVIDIA CUDA base with Python 3.10 and Ubuntu 22.04
FROM nvidia/cuda:11.8.0-base-ubuntu22.04

# --- 1. Install system dependencies required for C++ and audio module build ---
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libfftw3-dev \
    libsndfile1 \
    libgl1-mesa-glx \
    libglib2.0-0 \
    python3-pip \
    python3-dev \
    pybind11-dev \
    && rm -rf /var/lib/apt/lists/*

# --- 2. Set working directory for the app ---
WORKDIR /app

# --- 3. Copy all source files including C++, Python, Dagster configs ---
COPY . .

# --- 4. Set Dagster environment variables ---
ENV DAGSTER_HOME=/app/dagster_home
RUN mkdir -p $DAGSTER_HOME

ENV PYTHONPATH=/app/grass_pipeline_dagster

# --- 5. Build the C++ pybind11 module ---
WORKDIR /app/cpp_processing
RUN cmake . && make

# --- 6. Install Python dependencies (GPU-compatible PyTorch + project deps) ---
WORKDIR /app
RUN pip install --upgrade pip && \
    pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118 && \
    pip install -r grass_pipeline_dagster/requirements.dagster.txt

# --- 7. Start Dagster development UI with definitions.py ---
CMD ["dagster", "dev", "-h", "0.0.0.0", "-p", "3000", "-f", "grass_pipeline_dagster/grass_pipeline_dagster/definitions.py"]
