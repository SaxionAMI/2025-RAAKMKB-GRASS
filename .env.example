# ── Framework discovery ──────────────────────────────────────────────────────
AUDIO_OPS_TASKS_DIR=./tasks
DAGSTER_HOME=./dagster_home
FRAMEWORK_REF=v0.1.0                 # framework git tag the Docker image installs

# ── Storage: MinIO (this stack runs it) ──────────────────────────────────────
STORAGE_BACKEND=minio
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=audioops-bucket

# ── Metrics: InfluxDB (this stack runs it) ───────────────────────────────────
ENABLE_INFLUXDB=true
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=adminpassword
INFLUXDB_ORG=audioops
INFLUXDB_BUCKET=audio_metrics
INFLUXDB_TOKEN=dev-token-change-me   # CHANGE for anything beyond local demo

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── Experiment tracking ──────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=file:/app/mlruns

# ── Inference / streaming ────────────────────────────────────────────────────
DEVICE=cpu
CHUNK_MS=1000
ENABLE_FUSION=false
# The stream sensor reads MediaMTX's API to auto-register live streams:
MEDIAMTX_API=http://mediamtx:9997
