# Tell the framework where THIS project's tasks live.
AUDIO_OPS_TASKS_DIR=./tasks

# Keep Dagster's run storage local to the project (avoids ephemeral temp homes).
DAGSTER_HOME=./dagster_home

# Storage / metrics / tracking — all optional, default local/off.
STORAGE_BACKEND=local
ENABLE_INFLUXDB=false
MLFLOW_TRACKING_URI=file:./mlruns

# Enable object storage (then set use_remote_storage: true in the task config):
# STORAGE_BACKEND=minio
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET_NAME=audioops-bucket
