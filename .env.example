# Copy to .env. These values work for local runs (make train, make dev) without
# any services. docker-compose.yml overrides the service addresses inside the
# containers, so the same file also works for `make up`.
# All settings: https://saxionami.github.io/2026-AMI-AudioOpsFramework/reference/environment/

# Leave empty for the PyPI torch build (CUDA, also runs on CPU). For a small
# CPU-only image: https://download.pytorch.org/whl/cpu
TORCH_INDEX=

# Only the sentiment task, not the framework's example task.
AUDIO_OPS_DISABLE_BUILTIN_TASKS=true
DEVICE=auto

# Object storage. Local disk unless STORAGE_BACKEND=minio (the stack sets it).
STORAGE_BACKEND=local
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=audioops-bucket

# InfluxDB. Off for local runs; the stack switches it on. To write to the
# stack's InfluxDB from a local run, set ENABLE_INFLUXDB=true.
ENABLE_INFLUXDB=false
INFLUXDB_URL=http://localhost:8086
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=adminpassword
INFLUXDB_ORG=audioops
INFLUXDB_BUCKET=audio_metrics
INFLUXDB_TOKEN=dev-token-change-me    # change this for anything beyond a local demo

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Experiment tracking. The default is a local SQLite file in ./mlruns.
# MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db

# Live inference
CHUNK_MS=1000
ENABLE_FUSION=false
