FROM feyalt/grass-pipeline:api

# Audio/system dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \  
    libportaudio2 \
    libsndfile1 \
    build-essential && \
    rm -rf /var/lib/apt/lists/*

# FastAPI form upload 
RUN pip install --no-cache-dir python-multipart

# FFmpeg Python bindings
RUN pip install --no-cache-dir ffmpeg-python

# Ensure Python can import Dagster modules cleanly
ENV PYTHONPATH="${PYTHONPATH}:/app/grass_pipeline_dagster"

# Define default run command for FastAPI
CMD ["uvicorn", "api.api_realtime.realtime_api:app", "--host", "0.0.0.0", "--port", "8000"]
