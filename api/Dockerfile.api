FROM python:3.10-slim

WORKDIR /app

# 1. Install system dependencies required for C++/pybind11
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libfftw3-dev \
    libfftw3-single3 \
    libsndfile1 \
    ffmpeg \
    python3-dev \
    pybind11-dev \
    libportaudio2 \
    && rm -rf /var/lib/apt/lists/*

# 2. Install Python dependencies including Dagster
COPY grass_pipeline_dagster/requirements.dagster.txt ./requirements.txt
RUN pip install --upgrade pip && pip install --no-cache-dir -r requirements.txt dagster dagster-webserver
RUN pip install --no-cache-dir python-multipart

# 3. Copy API code as a package
COPY api /app/api

# 4. Copy cpp_processing C++ code and build the extension
COPY cpp_processing /app/cpp_processing
WORKDIR /app/cpp_processing
RUN rm -rf build CMakeCache.txt \
 && cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DPYBIND11_FINDPYTHON=ON \
 && cmake --build build -j \
 && cp build/*.so /app/cpp_processing/ \
 && strip --strip-unneeded /app/cpp_processing/*.so || true

# 5. Return to /app
WORKDIR /app

# 6. Ensure PYTHONPATH includes /app (so 'api' is importable)
ENV PYTHONPATH=/app:/app/grass_pipeline_dagster
ENV MPLBACKEND=Agg

EXPOSE 8000

# 7. Start FastAPI using the module path
CMD ["uvicorn", "api.predict_api:app", "--host", "0.0.0.0", "--port", "8000"]
